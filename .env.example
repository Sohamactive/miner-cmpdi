DATABASE_URL=postgresql+psycopg://localhost:5432/miner_db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=miner_chunks
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM Provider: gemini | bedrock
LLM_PROVIDER=gemini

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Bedrock (used when LLM_PROVIDER=bedrock)
AWS_REGION=us-east-1
BEDROCK_MODEL=google.gemma-2-31b

LLM_TIMEOUT_MS=120000
EXPORT_FOLDER=./data/reports